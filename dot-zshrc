# ============================================================
# FUNÇÕES
# ============================================================

# ------------------------------------------------------------
# Criar diretório e entrar
# ------------------------------------------------------------

mkcd() {
    [[ -n "$1" ]] || return 1

    mkdir -p -- "$1" &&
        cd -- "$1"
}


# ------------------------------------------------------------
# Extrair arquivos
# ------------------------------------------------------------

extract() {

    if [[ ! -f "$1" ]]; then
        print -u2 "Arquivo inválido: $1"
        return 1
    fi

    case "$1" in

        *.tar.bz2) tar xjf "$1" ;;
        *.tar.gz)  tar xzf "$1" ;;
        *.tar.xz)  tar xJf "$1" ;;
        *.tar.zst) tar --zstd -xf "$1" ;;
        *.tar)     tar xf "$1" ;;

        *.bz2)     bunzip2 "$1" ;;
        *.gz)      gunzip "$1" ;;
        *.xz)      xz -d "$1" ;;
        *.zst)     unzstd "$1" ;;

        *.zip)     unzip "$1" ;;
        *.7z)      7z x "$1" ;;
        *.rar)     unrar x "$1" ;;

        *)
            print -u2 "Formato não suportado: $1"
            return 1
            ;;

    esac
}


# ------------------------------------------------------------
# Limpar órfãos do Pacman
# ------------------------------------------------------------

clean() {

    local -a pkgs

    pkgs=("${(@f)$(pacman -Qtdq 2>/dev/null)}")

    if (( ${#pkgs} )); then
        sudo pacman -Rns -- "${pkgs[@]}"
    else
        print "Nenhum pacote órfão encontrado."
    fi
}


# ------------------------------------------------------------
# Navegação Zoxide + FZF
# ------------------------------------------------------------

j() {

    (( $+commands[zoxide] && $+commands[fzf] )) || return 1

    local dir

    dir=$(zoxide query -l 2>/dev/null | fzf \
        --height=40% \
        --layout=reverse \
        --border=rounded \
        --preview='eza --icons --tree --level=2 --color=always {}'
    ) || return 0

    [[ -n "$dir" ]] && cd -- "$dir"
}


