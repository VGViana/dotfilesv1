#!/usr/bin/env bash

set -euo pipefail

echo "╭──────────────────────────────────────╮"
echo "│        Atualização do CachyOS        │"
echo "╰──────────────────────────────────────╯"
echo

# Verifica conexão
if ! ping -c 1 -W 2 archlinux.org >/dev/null 2>&1; then
    echo "❌ Sem conexão com a internet."
    exit 1
fi

echo "→ Atualizando sistema..."
echo

sudo pacman -Syu

echo
echo "→ Limpando cache antigo de pacotes..."
sudo paccache -rk2

echo
echo "→ Verificando pacotes órfãos..."

orphans=$(pacman -Qtdq 2>/dev/null || true)

if [[ -n "$orphans" ]]; then
    echo "Pacotes órfãos encontrados:"
    echo "$orphans"
    echo
    sudo pacman -Rns $orphans
else
    echo "✓ Nenhum pacote órfão."
fi

echo
echo "╭──────────────────────────────────────╮"
echo "│       ✓ Sistema atualizado!          │"
echo "╰──────────────────────────────────────╯"
