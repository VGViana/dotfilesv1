#!/usr/bin/env bash

set -Eeuo pipefail

REPO="$HOME/dotfiles"
BRANCH="fedora"

info() {
  printf '\033[1;34m==>\033[0m %s\n' "$*"
}

success() {
  printf '\033[1;32m✓\033[0m %s\n' "$*"
}

warn() {
  printf '\033[1;33m⚠\033[0m %s\n' "$*"
}

die() {
  printf '\033[1;31m✗\033[0m %s\n' "$*" >&2
  exit 1
}

# ============================================================
# VALIDATION
# ============================================================

[[ -d "$REPO/.git" ]] || die "$REPO não é um repositório Git."

cd "$REPO"

CURRENT_BRANCH="$(git branch --show-current)"

[[ "$CURRENT_BRANCH" == "$BRANCH" ]] ||
  die "Você está na branch '$CURRENT_BRANCH'. O comando dots só sincroniza '$BRANCH'."

# ============================================================
# OPTIONS
# ============================================================

DRY_RUN=0

if [[ "${1:-}" == "--dry-run" ]]; then
  DRY_RUN=1
elif [[ $# -gt 0 ]]; then
  die "Uso: dots [--dry-run]"
fi

info "Sincronizando dotfiles do Fedora..."

# ============================================================
# HOME
# ============================================================

HOME_FILES=(
  ".bashrc"
  ".bash_profile"
  ".zshrc"
  ".gtkrc-2.0"
  ".Xresources"
)

for file in "${HOME_FILES[@]}"; do
  target="$REPO/dot-$file"

  if [[ -f "$HOME/$file" ]]; then
    cp -a "$HOME/$file" "$target"
  else
    rm -f "$target"
  fi
done

# ============================================================
# ~/.config
# ============================================================

CONFIG_DIRS=(
  "DankMaterialShell"
  "btop"
  "dankcal"
  "dgop"
  "environment.d"
  "gtk-3.0"
  "gtk-4.0"
  "hypr"
  "kitty"
  "nvim"
  "qt5ct"
  "qt6ct"
  "sioyek"
  "yazi"
  "xsettingsd"
)

CONFIG_FILES=(
  "mimeapps.list"
  "user-dirs.dirs"
  "user-dirs.locale"
  "xdg-terminals.list"
)

mkdir -p "$REPO/dot-config"

for dir in "${CONFIG_DIRS[@]}"; do
  source="$HOME/.config/$dir"
  target="$REPO/dot-config/$dir"

  if [[ -d "$source" ]]; then
    rm -rf "$target"
    cp -a "$source" "$target"
  else
    rm -rf "$target"
  fi
done

for file in "${CONFIG_FILES[@]}"; do
  source="$HOME/.config/$file"
  target="$REPO/dot-config/$file"

  if [[ -f "$source" ]]; then
    cp -a "$source" "$target"
  else
    rm -f "$target"
  fi
done

# ============================================================
# AUTOSTART
# ============================================================

AUTOSTART="$HOME/.config/autostart/com.danklinux.dankcalendar.desktop"

if [[ -f "$AUTOSTART" ]]; then
  mkdir -p "$REPO/dot-config/autostart"
  cp -a "$AUTOSTART" "$REPO/dot-config/autostart/"
else
  rm -f \
    "$REPO/dot-config/autostart/com.danklinux.dankcalendar.desktop"
fi

# ============================================================
# ~/.local/bin
# ============================================================

mkdir -p "$REPO/dot-local/bin"

find "$REPO/dot-local/bin" \
  -maxdepth 1 \
  -type f \
  ! -name 'dots' \
  -delete

while IFS= read -r -d '' file; do
  name="$(basename "$file")"

  [[ "$name" == "dots" ]] && continue

  cp -a "$file" "$REPO/dot-local/bin/$name"
done < <(
  find "$HOME/.local/bin" \
    -maxdepth 1 \
    -type f \
    -print0
)

# ============================================================
# REMOVE GENERATED / MACHINE-SPECIFIC FILES
# ============================================================

rm -f \
  "$REPO/dot-config/DankMaterialShell/.firstlaunch"

rm -rf \
  "$REPO/dot-config/qt5ct/colors" \
  "$REPO/dot-config/qt6ct/colors"

# ============================================================
# REMOVE SENSITIVE / PERSONAL STATE
# ============================================================

rm -rf \
  "$REPO/dot-config/akonadi" \
  "$REPO/dot-config/libaccounts-glib" \
  "$REPO/dot-config/pulse" \
  "$REPO/dot-config/dconf" \
  "$REPO/dot-config/kdeconnect" \
  "$REPO/dot-config/session"

rm -f \
  "$REPO/dot-config/emailidentities" \
  "$REPO/dot-config/emaildefaults" \
  "$REPO/dot-config/kmail2rc" \
  "$REPO/dot-config/kmailsearchindexingrc"

find "$REPO" \
  -type f \
  \( \
  -name '*.bak' \
  -o -name '*.backup*' \
  -o -name '*.old' \
  -o -name '*history*' \
  -o -name 'cookie' \
  -o -name '*.db' \
  -o -name '*.db-shm' \
  -o -name '*.db-wal' \
  -o -name 'privateKey.pem' \
  -o -name 'certificate.pem' \
  \) \
  -delete

# ============================================================
# FEDORA GITIGNORE
# ============================================================

cat >"$REPO/.gitignore" <<'GITIGNORE'
# ============================================================
# Shell history
# ============================================================

.bash_history
.zsh_history

# ============================================================
# Backups
# ============================================================

*.bak
*.backup*
*.old

# ============================================================
# Application databases
# ============================================================

*.db
*.db-shm
*.db-wal

# ============================================================
# Secrets / credentials
# ============================================================

cookie
privateKey.pem
certificate.pem

# ============================================================
# Personal / session state
# ============================================================

session/
akonadi/
dconf/
pulse/

# ============================================================
# Cache
# ============================================================

.cache/

# ============================================================
# DMS generated state
# ============================================================

.firstlaunch

# ============================================================
# Editor / temporary files
# ============================================================

*~
.#*
GITIGNORE

# ============================================================
# PERMISSIONS
# ============================================================

find "$REPO/dot-local/bin" \
  -type f \
  -exec chmod +x {} \; \
  2>/dev/null || true

# ============================================================
# DRY RUN
# ============================================================

echo
info "Alterações detectadas:"
echo

git status --short

if [[ "$DRY_RUN" == "1" ]]; then
  echo
  info "Modo dry-run: nenhum commit ou push será realizado."
  exit 0
fi

# ============================================================
# CHECK CHANGES
# ============================================================

if git diff --quiet && git diff --cached --quiet; then
  success "Nenhuma alteração encontrada."
  exit 0
fi

echo
git diff --stat

# ============================================================
# COMMIT
# ============================================================

git add \
  .gitignore \
  dot-bashrc \
  dot-bash_profile \
  dot-zshrc \
  dot-.gtkrc-2.0 \
  dot-.Xresources \
  dot-config \
  dot-local

TIMESTAMP="$(date '+%Y-%m-%d %H:%M:%S')"

git commit -m "sync(fedora): update dotfiles $TIMESTAMP"

# ============================================================
# PUSH
# ============================================================

info "Enviando branch '$BRANCH' para o GitHub..."

git push -u origin "$BRANCH"

echo
success "Dotfiles Fedora sincronizados com GitHub."
