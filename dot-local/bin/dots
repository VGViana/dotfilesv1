#!/usr/bin/env bash
set -euo pipefail

REPO="$HOME/dotfiles"

cd "$REPO"

if [[ -z "$(git status --porcelain)" ]]; then
    echo "✓ dotfiles: nada para sincronizar."
    exit 0
fi

echo "╭──────────────────────────────────────╮"
echo "│              DOTS SYNC               │"
echo "╰──────────────────────────────────────╯"
echo

echo "→ Alterações:"
git status --short
echo

git add -A

if git diff --cached --quiet; then
    echo "✓ dotfiles: nada para commitar."
    exit 0
fi

scope="$(
    git diff --cached --name-only |
    awk -F/ '
        $1=="dot-config" && $2=="hypr"              {print "hyprland"; next}
        $1=="dot-config" && $2=="DankMaterialShell" {print "dms"; next}
        $1=="dot-config" && $2=="nvim"              {print "neovim"; next}
        $1=="dot-config" && $2=="kitty"             {print "kitty"; next}
        $1=="dot-config" && $2=="yazi"              {print "yazi"; next}
        $1=="dot-config" && $2=="sioyek"            {print "sioyek"; next}
        $1=="dot-config" && $2=="doom"              {print "doom"; next}
        $1=="dot-config" && $2=="khal"              {print "khal"; next}
        $1=="dot-config" && $2=="ncspot"            {print "ncspot"; next}
        $1=="dot-local"                              {print "scripts"; next}
        $1=="dot-zshrc"                              {print "shell"; next}
        $1=="dot-bashrc"                             {print "shell"; next}
        $1=="dot-bash_profile"                       {print "shell"; next}
        {print "config"}
    ' |
    sort -u |
    paste -sd', ' -
)"

[[ -n "$scope" ]] || scope="config"

commit="dotfiles: update ${scope}"

echo "→ Commit: $commit"
git commit -m "$commit"

echo
echo "→ Push: VGViana/dotfilesv1"
git push origin main

echo
echo "✓ Dotfiles sincronizado."
