#!/usr/bin/env bash

set -u

# ============================================================
# FZF FILE FINDER
# Fedora + Arch
# ============================================================

# Dependências obrigatórias
for cmd in fd fzf; do
  if ! command -v "$cmd" >/dev/null 2>&1; then
    printf '❌ Comando não encontrado: %s\n' "$cmd" >&2
    exit 127
  fi
done

selected="$(
  fd \
    --hidden \
    --type f \
    --type d \
    --exclude .git \
    --exclude .cache \
    --exclude .local/share/Trash \
    --exclude node_modules \
    --exclude .venv \
    --exclude target \
    --exclude .npm \
    --exclude .cargo \
    . "$HOME" |
    fzf \
      --height=80% \
      --layout=reverse \
      --border \
      --no-scrollbar \
      --info=inline \
      --prompt='  󰈞  ' \
      --pointer='▶'
)"

# ============================================================
# CANCELAMENTO
# ============================================================

[[ -z "$selected" ]] && exit 0

# ============================================================
# DIRETÓRIO → YAZI
# ============================================================

if [[ -d "$selected" ]]; then

  if ! command -v yazi >/dev/null 2>&1; then
    printf '❌ Yazi não encontrado.\n' >&2
    exit 127
  fi

  if [[ -n "${KITTY_WINDOW_ID:-}" ]]; then
    exec yazi -- "$selected"
  fi

  if command -v kitty >/dev/null 2>&1; then
    exec kitty yazi -- "$selected"
  fi

  printf '❌ Kitty não encontrado.\n' >&2
  exit 127

fi

# ============================================================
# PDF → SIOYEK
# ============================================================

if [[ -f "$selected" && "${selected,,}" == *.pdf ]]; then

  if ! command -v sioyek >/dev/null 2>&1; then
    printf '❌ Sioyek não encontrado.\n' >&2
    exit 127
  fi

  setsid sioyek -- "$selected" \
    >/dev/null 2>&1 </dev/null &

  exit 0

fi

# ============================================================
# QUALQUER OUTRO ARQUIVO → NVIM
# ============================================================

if [[ -f "$selected" ]]; then

  if ! command -v nvim >/dev/null 2>&1; then
    printf '❌ Neovim não encontrado.\n' >&2
    exit 127
  fi

  if [[ -n "${KITTY_WINDOW_ID:-}" ]]; then
    exec nvim -- "$selected"
  fi

  if command -v kitty >/dev/null 2>&1; then
    exec kitty nvim -- "$selected"
  fi

  printf '❌ Kitty não encontrado.\n' >&2
  exit 127

fi

exit 1
