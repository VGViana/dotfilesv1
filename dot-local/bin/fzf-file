#!/usr/bin/env bash

set -u

# ============================================================
# FZF FILE FINDER
# ============================================================

selected="$(
  fd \
    --hidden \
    --type f \
    --type d \
    --exclude .git \
    --exclude .cache \
    --exclude .local/share/Trash \
    --exclude node_modules \
    --exclude .venv \
    --exclude target \
    --exclude .npm \
    --exclude .cargo \
    . "$HOME" |
    fzf \
      --height=80% \
      --layout=reverse \
      --border \
      --no-scrollbar \
      --info=inline \
      --prompt='  󰈞  ' \
      --pointer='▶'
)"

# ============================================================
# CANCELAMENTO
# ============================================================

[[ -z "$selected" ]] && exit 0

# ============================================================
# DIRETÓRIO → YAZI
# ============================================================

if [[ -d "$selected" ]]; then

  if [[ -n "${KITTY_WINDOW_ID:-}" ]]; then
    exec yazi "$selected"
  fi

  exec kitty yazi "$selected"

fi

# ============================================================
# PDF → SIOYEK
# ============================================================

if [[ -f "$selected" && "${selected,,}" == *.pdf ]]; then

  # Abre o Sioyek independentemente do terminal
  setsid sioyek -- "$selected" >/dev/null 2>&1 </dev/null &

  exit 0

fi

# ============================================================
# QUALQUER OUTRO ARQUIVO → NVIM
# ============================================================

if [[ -f "$selected" ]]; then

  if [[ -n "${KITTY_WINDOW_ID:-}" ]]; then
    exec nvim -- "$selected"
  fi

  exec kitty nvim -- "$selected"

fi

exit 1
