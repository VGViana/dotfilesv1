[locale]
timeformat = "%H:%M"
dateformat = "%d/%m/%Y"
longdateformat = "%A - %d/%m/%Y"
datetimeformat = "%d/%m/%Y %H:%M"
longdatetimeformat = "%A - %d/%m/%Y %H:%M"
local_timezone = America/Sao_Paulo
default_timezone = America/Sao_Paulo
weeknumbers = left
firstweekday = 1
unicode_symbols = true

[default]
default_calendar = pessoal
highlight_event_days = True
show_all_days = True
timedelta = 7d
print_new = event

[highlight_days]
method = fg
color = '#fabd2f'
multiple = '#fe8019'

[view]
dynamic_days = True
event_view_always_visible = True
blank_line_before_day = True
theme = dark
frame = color
agenda_event_format = {calendar-color}{start-end-time-style} {title}

[keybindings]
up = up, k
down = down, j
left = left, h
right = right, l
new = n
delete = d
view = enter
quit = q

